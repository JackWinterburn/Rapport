# Copy to .env (repo root) and fill in. Never commit .env.

# --- Server ---
PORT=8787
# Public URL the app is served from. Google redirects to $APP_URL/auth/google/callback.
APP_URL=http://localhost:5173
DATABASE_PATH=rapport.db
# Time zone used for "today" and for sending reminders after 9am.
TZ=Europe/London

# --- Google OAuth (https://console.cloud.google.com/apis/credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated emails allowed to sign in. Required in production.
ALLOWED_EMAILS=you@example.com

# Local development only: adds a "Continue as dev user" button. Refused when NODE_ENV=production.
DEV_LOGIN=true

# --- AI conversation capture (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Monthly cap on input+output tokens per user. Captures are refused once it's reached.
AI_MONTHLY_TOKEN_LIMIT=2000000

# --- Web push (optional) ---
# Generate with: npx web-push generate-vapid-keys
# If unset, keys are generated once and stored in the database.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
